# Absolute origin of the deployed site. Used for canonical, Open Graph and
# JSON-LD URLs. Copy to `.env.local` and set your real domain before deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# The contact form embeds a Tally form by ID. Leave it empty to render no form
# at all, in which case the Contact section keeps its email buttons.
# NEXT_PUBLIC_TALLY_FORM_ID=

# Optional. The Open Source section reads public repositories from the GitHub
# API, which allows 60 anonymous requests an hour, plenty at one refresh per
# hour. Set a token (any scope; public read is enough) to raise that limit.
# GITHUB_TOKEN=
