# Portfolio Environment Variables
# Copy this file to .env.local and fill in your values

# GitHub Personal Access Token (for GitHub API access, e.g., fetching repos/contributions)
# Create at: https://github.com/settings/tokens
# Scopes needed: public_repo (for public repos), repo (for private repos)
GITHUB_TOKEN=

# Public site URL (used for canonical URLs, sitemap, Open Graph, etc.)
# In production, Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically.
# Set this explicitly for custom domains or if not on Vercel.
NEXT_PUBLIC_SITE_URL=

# Tally Form ID for the contact form
# Create a form at https://tally.so and copy the form ID from the URL
# Example: https://tally.so/r/xxxxx -> form ID is "xxxxx"
NEXT_PUBLIC_TALLY_FORM_ID=