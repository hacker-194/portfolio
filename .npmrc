# Silences the audit summary printed after every install. The findings are in the
# lint toolchain only (eslint-config-next > fast-glob > micromatch > braces), no
# patched release exists yet, and the suggested "npm audit fix --force" downgrades
# eslint-config-next to the Next 14 line, which breaks lint and the build.
# What ships to visitors is checked with: npm run audit:prod
audit=false
